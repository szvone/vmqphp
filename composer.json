{
  "name": "gbtc007/vmqphp",
  "description": "vmqphp migrated to ThinkPHP 6.x with PHP 8+ compatibility",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "topthink/framework": "^6.1",
    "topthink/think-view": "^3.0",
    "topthink/think-multi-app": "^1.0",
    "topthink/think-captcha": "^3.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "phpcompatibility/php-compatibility": "dev-develop"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app/"
    }
  },
  "scripts": {
    "start": "php think run",
    "lint:php8": "phpcs -p --standard=PHPCompatibility --runtime-set testVersion 8.1- --ignore=vendor/* ."
  }
}
